      },
      {
        "model_id": "ood_08_combined_adverse_corner",
        "multipliers": {
          "inductance_h": 1.1,
          "resistance_ohm": 1.1,
          "current_delay_s": 1.2,
          "viscous_friction_nm_s_per_rad": 0.85,
          "speed_measurement_delay_s": 1.2,
          "inertia_kg_m2": 1.15,
          "torque_constant_nm_per_a": 0.9,
          "position_measurement_delay_s": 1.2
        }
      }
    ]
  },
  "test_scenarios": {
    "standard": {
      "current_reference_a": 0.5,
      "speed_reference_rad_s": 1.0,
      "position_reference_rad": 0.002,
      "load_torque_step_nm": 0.040825,
      "encoder_effects": false
    },
    "ood_stress": {
      "load_torque_step_nm": 0.08165,
      "encoder_effects": true,
      "encoder_noise_seed_base": 20260724,
      "meaning": "stronger simulated load plus provisional 23-bit quantization/noise"
    }
  },
  "acceptance_thresholds": {
    "hard_all_24_models": {
      "closed_loop_stable": true,
      "maximum_voltage_limit_ratio": 1.001,
      "maximum_current_limit_ratio": 1.001,
      "maximum_speed_limit_ratio": 1.001,
      "minimum_gain_margin_db": 3.0,
      "maximum_sensitivity_peak": 3.0,
      "minimum_current_to_speed_crossover_ratio": 4.0,
      "minimum_speed_to_position_crossover_ratio": 3.0
    },
    "minimum_phase_margin_deg": {
      "current": 20.0,
      "speed": 20.0,
      "position": 25.0
    },
    "in_distribution_performance": {
      "maximum_settling_time_s": {
        "current": 0.005,
        "speed": 0.1,
        "position": 0.3
      },
      "maximum_overshoot_ratio": {
        "current": 0.15,
        "speed": 0.1,
        "position": 0.2
      },
      "maximum_steady_state_error": 0.02,
      "maximum_standard_disturbance_peak_rad_s": 0.08,
      "maximum_standard_disturbance_recovery_s": 0.25
    },
    "ood_performance_policy": "report degradation score; stability, margins, hierarchy and hard limits remain mandatory"
  },
  "output_policy": {
    "test_ensemble": "data/processed/physics_motor_test.npz",
    "test_manifest": "data/processed/physics_motor_test_manifest.json",
    "final_report": "outputs/final_test/final_test_report.json",
    "consumption_marker": "outputs/final_test/FINAL_TEST_CONSUMED.json"
  }
}
